# AZ Contractor Pro - Environment Configuration

# Square API Configuration
# Get these from: https://developer.squareup.com/apps
SQUARE_ACCESS_TOKEN=your_square_access_token_here
SQUARE_LOCATION_ID=your_square_location_id_here
SQUARE_ENVIRONMENT=sandbox  # Change to 'production' when ready

# Base URL for your deployed application
BASE_URL=http://localhost:3000  # Change to your domain in production

# Email Configuration (Gmail example)
# For Gmail: Enable "Less secure app access" or use App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password_or_app_password
SMTP_FROM=info@azcontractorpro.com

# Admin notifications
ADMIN_EMAIL=admin@azcontractorpro.com

# Site engine — where a paid order gets built and published.
# Without these the payment still succeeds, the order is recorded, and the
# customer gets a "we are building it" email instead of a live URL.
ACP_DEPLOY_API=https://acp-api.netlify.app/api/deploy
ACP_BUILDER_KEY=the_same_shared_secret_the_engine_expects

# Google Apps Script web app URL that generated sites post their leads to.
# Leave it unset only if you intend to wire each client up individually.
ACP_LEAD_ENDPOINT=https://script.google.com/macros/s/.../exec

# Server Configuration
PORT=3000

# Optional: Webhook signature key (for verifying Square webhooks)
# SQUARE_WEBHOOK_SIGNATURE_KEY=your_webhook_signature_key
