# AZ Contractor Pro - Environment Configuration

# Stripe API keys: https://dashboard.stripe.com/apikeys
# Use sk_test_... while testing, sk_live_... when you go live
STRIPE_SECRET_KEY=sk_test_your_key_here
# Signing secret for the /api/stripe-webhook endpoint (whsec_...).
# Dashboard: Developers > Webhooks > your endpoint > Reveal secret.
# Local testing: printed by `stripe listen --forward-to localhost:3000/api/stripe-webhook`
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# Base URL for your deployed application (used for Stripe's success/cancel redirects)
BASE_URL=http://localhost:3000  # Change to your domain in production

# Only needed if az-contractor-pro.html is hosted somewhere other than this server
# ALLOWED_ORIGINS=https://azcontractorpro.com

# Email Configuration (Gmail example; use an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=info@azcontractorpro.com

# Admin notifications
ADMIN_EMAIL=admin@azcontractorpro.com

# CRM (CRM-Az-Contractor): every order shows up on the contractor's record
CRM_URL=https://crm.azcontractorpro.com
# An API key from CRM Settings > API keys
CRM_KEY=

# Server Configuration
PORT=3000
